---
layout: layout.njk
title: "Fitness & Athletics"
---
<link rel="stylesheet" href="/assets/css/fitness.css">
<script src="/assets/js/main.js" defer></script>
<script src="/assets/js/fitness.js" defer></script>

<section class="portfolio-hero">
  <h1>Fitness & Athletics</h1>
  <p class="tagline">Tracking disciplines, volume, and personal bests.</p>
</section>

<div class="portfolio-lower-wrapper">
  
  <div class="dashboard-container timeline-animate">
    
    <!-- Weekly Volume Insights -->
    <div class="dashboard-grid">
      <section class="dashboard-card main-stats">
        <h2 class="card-title">Weekly Summary</h2>
        <div class="stats-row">
          <div class="big-stat">
            <span class="stat-value">{{ strava.weeklyTotalDistance }} <small>km</small></span>
            <span class="stat-label">Total Distance</span>
          </div>
          <div class="big-stat">
            <span class="stat-value">{{ strava.recentActivities.length }}</span>
            <span class="stat-label">Activities</span>
          </div>
        </div>
        
        <!-- Volume Distribution Chart -->
        <div class="distribution-chart">
          <span class="chart-label">Discipline Mix</span>
          <div class="bar-container">
            {% for type, data in strava.weeklyVolume %}
            <div class="bar-segment {{ type | lower }}" 
                 style="width: {{ data.percentage }}%;" 
                 title="{{ type }}: {{ data.percentage }}%">
            </div>
            {% endfor %}
          </div>
          <div class="bar-legend">
            {% for type, data in strava.weeklyVolume %}
            <div class="legend-item">
              <span class="dot {{ type | lower }}"></span> {{ type }} ({{ data.percentage }}%)
            </div>
            {% endfor %}
          </div>
        </div>
      </section>

      <section class="dashboard-card insights">
        <h2 class="card-title">Weekly Insights</h2>
        <div class="insights-list">
          {% for type, data in strava.weeklyVolume %}
          <div class="insight-row">
             <span class="insight-icon">{% if type == 'Run' %}🏃{% elif type == 'Ride' %}🚴{% elif type == 'Swim' %}🏊{% elif type == 'WeightTraining' %}💪{% else %}✨{% endif %}</span>
             <div class="insight-content">
               <span class="insight-label">{{ type }} {% if data.isCardio %}Pace{% else %}Duration{% endif %}</span>
               <span class="insight-value">{% if data.isCardio %}{{ data.avgPace }}{% else %}{{ data.formattedTime }}{% endif %}</span>
             </div>
          </div>
          {% endfor %}
          {% if not strava.weeklyVolume %}
          <p class="no-data">Waiting for your first activity of the week!</p>
          {% endif %}
        </div>
      </section>
    </div>


    <!-- Yearly & Lifetime Stats Grid -->
    <div class="stats-comparison-grid">
      <section class="dashboard-card stats-comparison-card">
        <h2 class="card-title">This Year (YTD)</h2>
        <div class="stats-mini-grid">
          <div class="mini-stat">
            <span class="m-val">{{ strava.ytdStats.run.distance or 0 }} <small>km</small></span>
            <span class="m-lab">🏃 Run</span>
          </div>
          <div class="mini-stat">
            <span class="m-val">{{ strava.ytdStats.ride.distance or 0 }} <small>km</small></span>
            <span class="m-lab">🚴 Ride</span>
          </div>
          <div class="mini-stat">
            <span class="m-val">{{ (strava.ytdStats.run.time or 0) + (strava.ytdStats.ride.time or 0) }} <small>hrs</small></span>
            <span class="m-lab">⏱️ Total Time</span>
          </div>
        </div>
      </section>

      <section class="dashboard-card stats-comparison-card">
        <h2 class="card-title">Lifetime Totals</h2>
        <div class="stats-mini-grid">
          <div class="mini-stat">
            <span class="m-val">{{ strava.allTimeStats.run.distance or 0 }} <small>km</small></span>
            <span class="m-lab">🏃 Run</span>
          </div>
          <div class="mini-stat">
            <span class="m-val">{{ strava.allTimeStats.ride.distance or 0 }} <small>km</small></span>
            <span class="m-lab">🚴 Ride</span>
          </div>
          <div class="mini-stat">
            <span class="m-val">{{ (strava.allTimeStats.run.time or 0) + (strava.allTimeStats.ride.time or 0) }} <small>hrs</small></span>
            <span class="m-lab">⏱️ Total Time</span>
          </div>
        </div>
      </section>
    </div>

    <section class="dashboard-card heatmap-card">
      <h2 class="card-title">Activity Heatmap (Last 365 Days)</h2>
      <div class="heatmap-wrapper">
        <div class="heatmap-grid" id="heatmapGrid">
          {% for day in strava.heatmap %}
          <div class="heatmap-cell intensity-{{ day.intensity }}" 
               data-date="{{ day.date }}"
               data-count="{{ day.count }}"
               title="{{ day.date }}: {{ day.count }} activities">
          </div>
          {% endfor %}
        </div>
      </div>
      <div class="heatmap-info" id="heatmapInfo">
        Click a square to see activity details
      </div>
      <div class="heatmap-legend">
        <span>Less</span>
        <div class="heatmap-cell intensity-0"></div>
        <div class="heatmap-cell intensity-1"></div>
        <div class="heatmap-cell intensity-2"></div>
        <div class="heatmap-cell intensity-3"></div>
        <div class="heatmap-cell intensity-4"></div>
        <span>More</span>
      </div>
    </section>

    <!-- Recent Activity Feed (Moved to bottom) -->
    <section class="activity-section">
      <h2 class="section-title">Recent Adventures</h2>
      <div class="activity-list">
        {% for activity in strava.recentActivities %}
        <div class="activity-strip">
          <div class="activity-type-badge {{ activity.type | lower }}">
            {% if activity.type == 'Run' %}🏃{% elif activity.type == 'Ride' %}🚴{% elif activity.type == 'Swim' %}🏊{% else %}✨{% endif %}
          </div>
          <div class="activity-info">
            <div class="activity-main-info">
              <h3>{{ activity.name }}</h3>
              <span class="date">{{ activity.startDate | dateFilter }}</span>
            </div>
            <div class="activity-metrics">
              <div class="metric">
                <span class="m-val">{{ activity.distance }} <small>km</small></span>
                <span class="m-lab">Dist</span>
              </div>
              <div class="metric">
                <span class="m-val">{{ activity.pace }}</span>
                <span class="m-lab">Pace</span>
              </div>
              <div class="metric">
                <span class="m-val">{{ activity.total_elevation_gain }} <small>m</small></span>
                <span class="m-lab">Gain</span>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </section>


    <p class="sync-footer">Last synced: {{ strava.lastUpdated | dateFilter }}</p>
  </div>

</div>
