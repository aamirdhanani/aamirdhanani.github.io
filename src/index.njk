<!-- HERO -->
<header class="hero shell">
  <div class="hero-grid">
    <div>
      <span class="eyebrow u-mono anim-up"><span class="d">&#9670;</span> Builder &middot; Avid runner &middot; Photographer &middot; Cool guy</span>
      <p class="h1 anim-clip">Hi, I'm Aamir.<br>I build things and <i>chase&nbsp;light.</i></p>
      <p class="lede anim-up">Software developer by day, maker and distance runner by choice. This is the short version of who I am, and the easiest way to reach me.</p>
      <div class="hero-actions anim-up">
        <a href="#contact" class="btn">Get in touch <span class="arw">&rarr;</span></a>
        <a href="#photo" class="btn ghost">See my photos</a>
      </div>
      <div class="scrollcue anim-up"><span class="bar"></span> Scroll to explore</div>
    </div>
    <figure class="frame anim-up anim-frame" style="margin:0">
      <img class="shot" id="heroShot" alt="Aamir Dhanani" width="800" height="1000">
      <script>
        /* Pick a random hero photo on each visit (set before paint to avoid a flash). */
        (function(){
          var shots = ['/images/homepage/me.jpg','/images/homepage/hero-3.jpg','/images/homepage/hero-4.jpg','/images/homepage/hero-5.jpg'];
          var el = document.getElementById('heroShot');
          if (el) el.src = shots[Math.floor(Math.random() * shots.length)];
        })();
      </script>
      <div class="ov"></div>
      <span class="exif">&fnof;/1.8 &middot; 1/250s &middot; ISO 100 &middot; 35mm</span>
    </figure>
  </div>
</header>

