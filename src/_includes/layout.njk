<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.title or "Aamir Dhanani" }}</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="icon" type="image/png" href="/assets/favicon.png">
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  <script>(function(){try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}})()</script>
  <link rel="stylesheet" href="/assets/site.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
  <script>document.documentElement.classList.add('js')</script>

  <nav class="nav" id="nav">
    <div class="shell nav-in">
      <a href="/" class="brand">Aamir Dhanani</a>
      <div class="nav-links" id="navlinks">
        <a href="/portfolio/" {% if page.url.startsWith('/portfolio/') %}class="active" aria-current="page"{% endif %}>Portfolio</a>
        <a href="/hobbies/" {% if page.url.startsWith('/hobbies/') %}class="active" aria-current="page"{% endif %}>Hobbies</a>
        <a href="/fitness/" {% if page.url.startsWith('/fitness/') %}class="active" aria-current="page"{% endif %}>Fitness</a>
        <a href="/travel/" {% if page.url.startsWith('/travel/') %}class="active" aria-current="page"{% endif %}>Travel</a>
        <a href="/contact/" class="nav-cta {% if page.url.startsWith('/contact/') %}active{% endif %}">Contact</a>
      </div>
      <div class="nav-tools">
        <button class="theme" id="theme" type="button" aria-label="Toggle dark mode">
          <svg class="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <button class="burger" id="burger" type="button" aria-label="Menu"><span></span><span></span><span></span></button>
      </div>
    </div>
  </nav>

  <main class="content">
    {{ content | safe }}
  </main>

  <footer class="foot">
    <div class="shell foot-bar">
      <span>&copy; 2026 Aamir Dhanani</span>
      <a href="/contact/">Get in touch &rarr;</a>
      <a href="#" style="color:inherit">Back to top &uarr;</a>
    </div>
  </footer>

  <script src="/assets/js/site.js" defer></script>
  <script data-goatcounter="https://aamirdhanani.goatcounter.com/count"
          async src="//gc.zgo.at/count.js"></script>
</body>
</html>
