---
layout: /layout.njk
title: "Hobbies and Interests"
---
<script src="/assets/js/main.js" defer></script>

<section class="portfolio-hero">
  <h1>Hobbies and Interests</h1>
  <p class="tagline">Things I explore, practice, and enjoy.</p>
</section>

<div class="portfolio-lower-wrapper">
  <div class="projects-list timeline-animate">

    {% set sortedHobbies = hobbies.hobbies | sort(attribute="title") %}

    {% for hobby in sortedHobbies %}
    <div class="project-card">

      {% if hobby.image %}
        <img src="{{ hobby.image }}" alt="{{ hobby.title }}" loading="lazy">
      {% else %}
        <div class="project-media-placeholder" aria-hidden="true">
          <span class="placeholder-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="3"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <path d="M21 15l-5-5a2 2 0 0 0-2.8 0L5 18"></path>
            </svg>
          </span>
        </div>
      {% endif %}

      <div class="project-content">
        <h2>{{ hobby.title }}</h2>
        <p>{{ hobby.description }}</p>
      </div>

    </div>
    {% endfor %}

  </div>
</div>
