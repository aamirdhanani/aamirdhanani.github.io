---
layout: /layout.njk
title: "Travel"
---
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" defer></script>
<script>window.TRAVEL_PLACES = {{ places | dump | safe }};</script>
<script src="/assets/js/travel-map.js" defer></script>
<script src="/assets/js/main.js" defer></script>

<section class="portfolio-hero">
  <h1>Travel</h1>
  <p class="tagline">A log of trips I've been on over the past few years.</p>
  <button id="mapToggle" class="hero-button" type="button" aria-expanded="true" aria-controls="travelMap"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19.5 3.5 22V6.5L9 4m0 15.5 6-2.5M9 19.5V4m6 12.5L20.5 19V3.5L15 6m0 10.5V6m0 0L9 4"/></svg> <span class="mt-label">Hide map</span></button>
</section>

<div id="travelMap" class="travel-map"></div>


<div class="portfolio-lower-wrapper">
<div class="timeline-container">
  {% for yearBlock in travel.timeline %}
    <h2 class="timeline-year">{{ yearBlock.year }}</h2>

    {% for item in yearBlock.items %}
      <div class="timeline-item timeline-animate">
        <div class="timeline-dot"></div>

        <div class="timeline-content">
          <h3>{{ item.month }} – {{ item.location }}</h3>
          <p>{{ item.description }}</p>

          {% if item.image %}
            <img src="{{ item.image }}" alt="{{ item.location }}" loading="lazy">
          {% endif %}
        </div>
      </div>
    {% endfor %}
  {% endfor %}
</div>

</div>