<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Aamir Dhanani" }}</title>
  <meta name="description" content="Aamir Dhanani — software developer, avid runner, and photographer based in Ontario, Canada. Builder of things, chaser of light.">
  <link rel="icon" type="image/png" href="/assets/favicon.png">
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  <link rel="stylesheet" href="/assets/home.css">
</head>
<body>
  <script>document.documentElement.classList.add('js')</script>

  <!-- Minimal sticky masthead: journal label + ruler + the menu toggle folded in. -->
  <header class="masthead">
    <div class="shell masthead-in">
      <span class="masthead-label u-mono">A public journal</span>
      <span class="ticks" aria-hidden="true"></span>
      <button class="menu-btn" id="menuBtn" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="menuOverlay">
        <span class="menu-btn-label">Menu</span>
        <span class="menu-btn-icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </header>
  <div class="menu-overlay" id="menuOverlay" role="dialog" aria-modal="true" aria-label="Site menu">
    <nav class="menu-nav" aria-label="Pages">
      <a href="/portfolio/">Portfolio</a>
      <a href="/hobbies/">Hobbies</a>
      <a href="/fitness/">Fitness</a>
      <a href="/travel/">Travel</a>
      <a href="/contact/">Contact</a>
    </nav>
    <div class="menu-foot">
      <span class="menu-foot-k">Reach me</span>
      <a href="mailto:contact@aamirdhanani.com">contact@aamirdhanani.com</a>
    </div>
  </div>

  <main>
    <h1 class="sr-only">Aamir Dhanani. Builder, avid runner, and photographer.</h1>
    {{ content | safe }}
  </main>

  <footer class="foot" id="foot">
    <div class="shell">
      <div class="foot-bar">
        <span>&copy; 2026 Aamir Dhanani</span>
        <a href="#" style="color:inherit">Back to top &uarr;</a>
      </div>
    </div>
  </footer>

  <script src="/assets/js/home.js" defer></script>
  <script data-goatcounter="https://aamirdhanani.goatcounter.com/count"
          async src="//gc.zgo.at/count.js"></script>
</body>
</html>
