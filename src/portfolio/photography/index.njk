---
layout: layout.njk
title: Photography
---
<script src="/assets/js/main.js" defer></script>

<section class="portfolio-hero">
  <a href="/portfolio/" class="breadcrumb-link">&larr; Portfolio</a>
  <h1>Photography</h1>
  <p class="tagline">Collections captured through my lens.</p>
</section>

<div class="portfolio-lower-wrapper">
<section class="photo-category-grid timeline-animate">
  {% for cat in categories %}
  <a class="photo-category-card" href="{{ cat.url }}">
    <div class="photo-thumb" style="background-image: url('/portfolio/photography/{{ cat.name }}/{{ cat.cover }}')"></div>
    <h2>{{ cat.name | capitalize }}</h2>
  </a>
  {% endfor %}
</section>
</div>