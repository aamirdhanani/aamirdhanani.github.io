---
layout: /layout.njk
title: "Fitness & Athletics"
---
<link rel="stylesheet" href="/assets/css/fitness.css">
<script src="/assets/js/main.js" defer></script>
<script src="/assets/js/fitness.js" defer></script>

<section class="portfolio-hero">
  <h1>Fitness & Athletics</h1>
  <p class="tagline">Tracking disciplines, volume, and personal bests.</p>
</section>

<div class="portfolio-lower-wrapper">
  
  <div class="dashboard-container">
    
    <!-- Weekly Volume Insights -->
    <div class="dashboard-grid">
      <section class="dashboard-card main-stats">
        <h2 class="card-title">Last 7 Days</h2>
        <div class="stats-row">
          <div class="big-stat">
            <span class="stat-value">{{ fitness.weeklyTotalDistance }} <small>km</small></span>
            <span class="stat-label">Distance</span>
          </div>
          <div class="big-stat">
            <span class="stat-value">{{ fitness.weeklyCount }}</span>
            <span class="stat-label">{% if fitness.weeklyCount == 1 %}Session{% else %}Sessions{% endif %}</span>
          </div>
        </div>

        {% if fitness.weeklyCount > 0 %}
        <!-- Volume Distribution Chart -->
        <div class="distribution-chart">
          <span class="chart-label">Discipline Mix</span>
          <div class="bar-container">
            {% for type, data in fitness.weeklyVolume %}
            <div class="bar-segment {{ type | lower }}"
                 style="width: {{ data.percentage }}%;"
                 title="{{ type }}: {{ data.percentage }}%">
            </div>
            {% endfor %}
          </div>
          <div class="bar-legend">
            {% for type, data in fitness.weeklyVolume %}
            <div class="legend-item">
              <span class="dot {{ type | lower }}"></span> {{ type | replace("WeightTraining", "Weight Training") }} ({{ data.percentage }}%)
            </div>
            {% endfor %}
          </div>
        </div>
        {% else %}
        <div class="empty-panel">
          <span class="empty-panel-icon">🌙</span>
          <p class="empty-panel-text">Rest week — nothing logged in the last 7 days.<br>The lifetime totals below still tell the story.</p>
        </div>
        {% endif %}
      </section>

      <section class="dashboard-card insights">
        <h2 class="card-title">Training Focus</h2>
        {% if fitness.weeklyCount > 0 %}
        <div class="insights-list">
          {% for type, data in fitness.weeklyVolume %}
          <div class="insight-row">
             <span class="insight-icon">{% if type == 'Run' %}🏃{% elif type == 'Ride' %}🚴{% elif type == 'Swim' %}🏊{% elif type == 'WeightTraining' %}💪{% elif type == 'Hike' %}🥾{% elif type == 'Walk' %}🚶{% else %}✨{% endif %}</span>
             <div class="insight-content">
               <span class="insight-label">{{ type | replace("WeightTraining", "Weight Training") }} · {% if data.count == 1 %}1 session{% else %}{{ data.count }} sessions{% endif %}</span>
               <span class="insight-value">{% if data.isCardio %}{{ data.avgPace or data.distanceKm + ' km' }}{% else %}{{ data.formattedTime }}{% endif %}</span>
             </div>
          </div>
          {% endfor %}
        </div>
        {% else %}
        <div class="empty-panel">
          <span class="empty-panel-icon">✨</span>
          <p class="empty-panel-text">No sessions this week yet.<br>Your next activity shows up here after it syncs.</p>
        </div>
        {% endif %}
      </section>
    </div>


    <!-- Yearly & Lifetime Stats Grid -->
    <div class="stats-comparison-grid">
      <section class="dashboard-card stats-comparison-card">
        <h2 class="card-title">This Year (YTD)</h2>
        <div class="stats-mini-grid">
          <div class="mini-stat">
            <span class="m-val">{{ fitness.ytdStats.run.distance or 0 }} <small>km</small></span>
            <span class="m-lab">🏃 Run</span>
          </div>
          <div class="mini-stat">
            <span class="m-val">{{ fitness.ytdStats.ride.distance or 0 }} <small>km</small></span>
            <span class="m-lab">🚴 Ride</span>
          </div>
          <div class="mini-stat">
            <span class="m-val">{{ (fitness.ytdStats.run.time or 0) + (fitness.ytdStats.ride.time or 0) }} <small>hrs</small></span>
            <span class="m-lab">⏱️ Total Time</span>
          </div>
        </div>
      </section>

      <section class="dashboard-card stats-comparison-card">
        <h2 class="card-title">Lifetime Totals</h2>
        <div class="stats-mini-grid">
          <div class="mini-stat">
            <span class="m-val">{{ fitness.allTimeStats.run.distance or 0 }} <small>km</small></span>
            <span class="m-lab">🏃 Run</span>
          </div>
          <div class="mini-stat">
            <span class="m-val">{{ fitness.allTimeStats.ride.distance or 0 }} <small>km</small></span>
            <span class="m-lab">🚴 Ride</span>
          </div>
          <div class="mini-stat">
            <span class="m-val">{{ (fitness.allTimeStats.run.time or 0) + (fitness.allTimeStats.ride.time or 0) }} <small>hrs</small></span>
            <span class="m-lab">⏱️ Total Time</span>
          </div>
        </div>
      </section>
    </div>

    <section class="dashboard-card heatmap-card">
      <h2 class="card-title">Activity Heatmap (Last 365 Days)</h2>
      <div class="heatmap-wrapper">
        <div class="heatmap-grid" id="heatmapGrid">
          {% for day in fitness.heatmap %}
          <div class="heatmap-cell intensity-{{ day.intensity }}" 
               data-date="{{ day.date }}"
               data-count="{{ day.count }}"
               title="{{ day.date }}: {{ day.count }} activities">
          </div>
          {% endfor %}
        </div>
      </div>
      <div class="heatmap-info" id="heatmapInfo">
        Click a square to see activity details
      </div>
      <div class="heatmap-legend">
        <span>Less</span>
        <div class="heatmap-cell intensity-0"></div>
        <div class="heatmap-cell intensity-1"></div>
        <div class="heatmap-cell intensity-2"></div>
        <div class="heatmap-cell intensity-3"></div>
        <div class="heatmap-cell intensity-4"></div>
        <span>More</span>
      </div>
    </section>

    <!-- Recent Activity Feed — each card's cover is the GPS route, drawn as
         inline SVG line-art (baked at sync time; no map tiles or API keys). -->
    <section class="activity-section">
      <h2 class="section-title">Recent Adventures</h2>
      <div class="route-grid">
        {% for activity in fitness.recentActivities %}
        <article class="route-card">
          <div class="route-map">
            {% if activity.route %}
            <svg class="route-svg" viewBox="0 0 100 70" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
              <path class="route-line" pathLength="1" d="{{ activity.route.d }}"/>
              <circle class="route-dot route-dot--start" cx="{{ activity.route.sx }}" cy="{{ activity.route.sy }}" r="2.4"/>
              <circle class="route-dot route-dot--end" cx="{{ activity.route.ex }}" cy="{{ activity.route.ey }}" r="2.4"/>
            </svg>
            {% else %}
            <div class="route-empty">
              <span class="route-empty-icon">{% if activity.type == 'Swim' %}🏊{% elif activity.type == 'WeightTraining' %}💪{% else %}✨{% endif %}</span>
              <span class="route-empty-label">Indoor · no GPS</span>
            </div>
            {% endif %}
            <span class="route-badge">{% if activity.type == 'Run' %}🏃{% elif activity.type == 'Ride' %}🚴{% elif activity.type == 'Swim' %}🏊{% elif activity.type == 'Hike' %}🥾{% elif activity.type == 'Walk' %}🚶{% elif activity.type == 'WeightTraining' %}💪{% else %}✨{% endif %}</span>
            {% if activity.distance and activity.distance != '0.00' %}<span class="route-dist">{{ activity.distance }} km</span>{% endif %}
          </div>
          <div class="route-body">
            <h3 class="route-name">{{ activity.name }}</h3>
            <span class="route-date">{{ activity.startDate | dateFilter }}</span>
            <div class="route-metrics">
              {% if activity.pace %}<div class="route-metric"><span class="rv">{{ activity.pace }}</span><span class="rl">Pace</span></div>{% endif %}
              <div class="route-metric"><span class="rv">{{ activity.total_elevation_gain }}<small>m</small></span><span class="rl">Elev</span></div>
            </div>
          </div>
        </article>
        {% endfor %}
      </div>
    </section>


    <p class="sync-footer">Last synced: {{ fitness.lastUpdated | dateFilter }}</p>
  </div>

</div>
