---
layout: /layout.njk
pagination:
  data: categories
  size: 1
  alias: category
permalink: "/portfolio/photography/{{ category.name }}/"
---
<script src="/assets/js/main.js" defer></script>
<script src="/assets/js/lightbox.js" defer></script>

<section class="portfolio-hero">
  <a href="/portfolio/photography/" class="breadcrumb-link">&larr; Photography</a>
  <h1>{{ category.name | capitalize }}</h1>
</section>

<div class="portfolio-lower-wrapper">
  <div class="photo-grid timeline-animate">
    {% for img in category.images %}
      <a href="/portfolio/photography/{{ category.encodedName }}/{{ img }}"
         class="photo-item"
         data-lightbox="gallery">
        <img src="/portfolio/photography/{{ category.encodedName }}/{{ img }}" alt="{{ category.name | capitalize }} photo" loading="lazy">
      </a>
    {% endfor %}
  </div>
</div>
