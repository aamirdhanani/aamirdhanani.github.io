---
layout: /layout.njk
title: "Racing & Athletics"
---
<script src="/assets/js/main.js" defer></script>

<section class="portfolio-hero">
  <a href="/portfolio/" class="breadcrumb-link">&larr; Portfolio</a>
  <h1>Racing & Athletics</h1>
  <p class="tagline">A collection of races, personal records, and athletic milestones.</p>
</section>

<div class="portfolio-lower-wrapper">
<div class="projects-list timeline-animate">
  {% for race in racing.races %}
  <div class="project-card">
      {% if race.image %}
        <img src="{{ race.image }}" alt="{{ race.title }}" loading="lazy">
      {% else %}
        <div class="project-media-placeholder" aria-hidden="true">
          <span class="placeholder-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="3"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <path d="M21 15l-5-5a2 2 0 0 0-2.8 0L5 18"></path>
            </svg>
          </span>
        </div>
      {% endif %}
    <div class="project-content">
      <h2>{{ race.title }}</h2>
      <h3>{{ race.time }}</h3>
      <p>{{ race.description }}</p>
    </div>
  </div>
  {% endfor %}
</div>
</div>
