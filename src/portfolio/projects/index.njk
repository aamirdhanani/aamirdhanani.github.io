---
layout: /layout.njk
title: "Projects"
---
<script src="/assets/js/main.js" defer></script>

<section class="portfolio-hero">
  <a href="/portfolio/" class="breadcrumb-link">&larr; Portfolio</a>
  <h1>Projects</h1>
  <p class="tagline">Things I've built, explored, and shared.</p>
</section>

<div class="portfolio-lower-wrapper">
<section class="projects-list">

  {% set sortedProjects = projects | sort(attribute="title") %}

  {% for project in sortedProjects %}
    <article class="project-card timeline-animate" id="{{ project.title | slugify }}">

      {% if project.image %}
        <img src="{{ project.image }}" alt="{{ project.title }}" loading="lazy">
      {% endif %}

      <div class="project-content">
        <h2>{{ project.title }}</h2>
        <p>{{ project.description }}</p>
        {% if project.url %}
        <a href="{{ project.url }}" class="project-link" target="_blank" rel="noopener noreferrer">Visit project &rarr;</a>
        {% endif %}
      </div>

    </article>
  {% endfor %}

</section>
</div>
